{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voicemail-to-mms",
  "main": "src/diagnostic-wrapper.js",
  "compatibility_date": "2026-08-31",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://voicemail-to-mms.landauvolvie.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "VOICEMAIL_BUCKET",
      "bucket_name": "voicemail-to-mms-audio"
    }
  ]
}
